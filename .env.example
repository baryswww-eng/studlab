# ---------------------------------------------------------------
# STUD LAB — environment template.
# Copy to .env and fill in values. NEVER commit .env to Git.
# ---------------------------------------------------------------

# --- App ---
# One of: development | test | production
ENVIRONMENT=development
DEBUG=false

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
SESSION_EXPIRE_DAYS=7
# true behind HTTPS (forced on when ENVIRONMENT=production)
COOKIE_SECURE=false
# Comma-separated list of exact frontend origins (no "*").
CORS_ORIGINS=http://localhost:3000


# --- PostgreSQL ---
POSTGRES_USER=studlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studlab
# Used when the backend runs on the host (not in Docker).
DATABASE_URL=postgresql+asyncpg://studlab:change-me@127.0.0.1:5432/studlab
# Optional: separate DB for integration tests (pytest).
# TEST_DATABASE_URL=postgresql+asyncpg://studlab:change-me@127.0.0.1:5432/studlab_test

# --- Redis (optional) ---
REDIS_URL=redis://localhost:6379/0


# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: shown in the footer / About page only when set.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: "Label|https://url,Label|https://url"
NEXT_PUBLIC_SOCIAL_LINKS=


# --- AI tutor: Google Gemini (server-side only; get a key at https://aistudio.google.com/apikey) ---
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite
# Per-model timeout; after it the next fallback model is tried.
AI_TIMEOUT_SECONDS=45
